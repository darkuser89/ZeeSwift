/* MetalFX presentation */
"Upscaling" = "Hochskalierung";
"Upscales the game image when the window is larger than the internal resolution. Applies immediately. Pixel-perfect texture scaling remains a separate setting." = "Vergrößert das Spielbild, wenn das Fenster größer als die interne Auflösung ist. Wirkt sofort. Pixelgenaue Texturskalierung bleibt separat einstellbar.";
"MetalFX is not supported on this Mac." = "MetalFX wird auf diesem Mac nicht unterstützt.";

"Temporal uses depth and motion from 3D rendering. Images without valid temporal data use Spatial automatically." = "Temporal verwendet Tiefen- und Bewegungsdaten der 3D-Darstellung. Bilder ohne gültige Temporal-Daten verwenden automatisch Spatial.";

